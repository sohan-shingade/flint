# ─── Data Providers ───────────────────────────────────────────────
# Enable/disable providers by setting their API keys.
# Drift Data API requires no key — always available.

# Birdeye — OHLCV for any Solana token (free tier, no CC)
# Sign up at https://birdeye.so/developers
FLINT_BIRDEYE_API_KEY=

# Helius — on-chain events, parsed transactions, DAS API (free tier, no CC)
# Sign up at https://helius.dev
FLINT_HELIUS_API_KEY=

# Pyth — real-time oracle price feeds (no key required)
# Enabled by default when providers.pyth.enabled=true

# CCXT — access any exchange (pip install flint[ccxt])
# FLINT_CCXT_EXCHANGE=binance
# FLINT_CCXT_API_KEY=
# FLINT_CCXT_SECRET=

# ─── Execution Venue Data ─────────────────────────────────────────
# Tardis.dev — historical CEX orderbook data for realistic fill simulation
# Required for Binance/OKX/Bybit orderbook depth. Without it, synthetic depth is used.
# Sign up at https://tardis.dev (free tier available)
FLINT_TARDIS_API_KEY=

# Dune Analytics — historical Jupiter Perps borrow rates
# Required for Jupiter borrow rate backfill. Without it, only live RPC snapshots are collected.
# Sign up at https://dune.com (free tier: 2500 credits/month)
FLINT_DUNE_API_KEY=

# ─── Jupiter Perps ────────────────────────────────────────────────
# Enable Jupiter Perps live execution sidecar
# FLINT_JUPITER_PERPS_ENABLED=false
# FLINT_JUPITER_PERPS_SIDECAR_PORT=8401
# FLINT_JUPITER_PERPS_RPC_URL=https://api.mainnet-beta.solana.com
# FLINT_JUPITER_PERPS_WALLET_PATH=~/.config/solana/id.json

# ─── Solana RPC ───────────────────────────────────────────────────
# Optional — only needed for live trading and on-chain queries
# Sign up at helius.dev for a free key, no credit card required
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ─── Notifications (all optional) ────────────────────────────────
FLINT_TELEGRAM_BOT_TOKEN=
FLINT_TELEGRAM_CHAT_ID=
FLINT_DISCORD_WEBHOOK_URL=
