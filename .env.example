# ─── Historical Market Data ────────────────────────────────────────
# Tardis.dev — historical Hyperliquid tick and order-book data
# Optional BYO license for backfilling local tick/book coverage.
# Sign up at https://tardis.dev
TARDIS_API_KEY=

# ─── Solana RPC ───────────────────────────────────────────────────
# Optional — only needed for live trading and on-chain queries
# Sign up at helius.dev for a free key, no credit card required
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ─── Notifications (all optional) ────────────────────────────────
FLINT_TELEGRAM_BOT_TOKEN=
FLINT_TELEGRAM_CHAT_ID=
FLINT_DISCORD_WEBHOOK_URL=
